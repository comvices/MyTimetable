# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT_GATEWAY_SECRET: Server-side HMAC secret for payment webhook signature verification.
PAYMENT_GATEWAY_SECRET=

# STRIPE_SECRET_KEY: Optional live payment gateway secret key (server-side only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AUTH_TOKEN_SECRET: Server-side HMAC secret for session Bearer tokens (recommended on Vercel).
AUTH_TOKEN_SECRET=

# SUPER_ADMIN_USERNAME / SUPER_ADMIN_PASSWORD: Optional server-side Super Admin credentials.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
